{
  "clarity-through-systems": {
    "title": "System-first clarity",
    "subtitle": "Whether it's product architecture or component design, simplify complexity with clear hierarchy, structure, & consistency so users can focus on what matters most.",
    "bodyHtml": "<h4>What this looks like</h4>\n<ul class=\"drawer-list\">\n  <li>Established hierarchy with consistent sizing, layout &amp; spacing</li>\n  <li>Predictable &amp; consistent patterns to reduce user cognitive load</li>\n  <li>Reuse existing components whenever possible</li>\n  <li>Ensure new components slot cleanly into the larger design system</li>\n</ul>\n\n<h4>Why this matters</h4>\n<ul class=\"drawer-list\">\n  <li>Prevents inconsistencies across the app</li>\n  <li>Reduces cognitive load with predictable structure</li>\n  <li>Scales decisions beyond individuals</li>\n</ul>\n\n<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:24px;\">\n  <h4 style=\"margin:0;\">Real-life Example</h4>\n  <button class=\"drawer-example__refresh\" type=\"button\">\n    <span aria-hidden=\"true\">⟳</span> Refresh\n  </button>\n</div>\n\n<div style=\"margin-top:12px;border:1px solid var(--border);border-radius:14px;overflow:hidden;\">\n  <img src=\"./assets/clarity-execution-criteria.png\" alt=\"Accord Execution Criteria preview\" style=\"display:block;width:100%;height:auto;\" loading=\"lazy\">\n</div>\n\n<p class=\"drawer-caption\" style=\"margin-top:14px;\">\n  <span style=\"color:var(--muted);\">Accord: Figma for Sales</span><br>\n  <strong>Accord Execution Criteria</strong>\n</p>",
    "badge": "Design Tenet"
  },
  "pixels-serve-a-purpose": {
    "title": "Purposeful pixels",
    "subtitle": "Visual polish is only valuable when it serves the user’s understanding or confidence… not just to make things look pretty. Pixels without intent only add cognitive load.",
    "bodyHtml": "<div aria-hidden=\"true\" style=\"width:28px;height:28px;color:var(--brand);\">\n  <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n    <path d=\"M20 4a3 3 0 0 0-4.2 0l-8.9 8.9c-.2.2-.4.5-.5.8l-1 3.6c-.2.7.4 1.3 1.1 1.1l3.6-1c.3-.1.6-.3.8-.5L20 8.2A3 3 0 0 0 20 4Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n    <path d=\"M13.2 6.8l4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n  </svg>\n</div>\n\n<div style=\"margin-top:10px;\">\n  <span class=\"chip\" style=\"cursor:default;\">Design Tenet</span>\n</div>\n\n<hr style=\"border:0;border-top:1px solid var(--border);margin:16px 0;\" />\n\n<h3 style=\"margin:0 0 10px 0;font-size:18px;letter-spacing:-0.01em;\">What this looks like</h3>\n<ul style=\"margin:0 0 18px 0;padding-left:18px;\">\n  <li>Remove visuals that don’t support clarity or action</li>\n  <li>Use color, spacing, &amp; motion intentionally</li>\n  <li>Prioritize meaning over decoration</li>\n  <li>Make every pixel justify its existence</li>\n</ul>\n\n<h3 style=\"margin:0 0 10px 0;font-size:18px;letter-spacing:-0.01em;\">Why this matters</h3>\n<ul style=\"margin:0 0 22px 0;padding-left:18px;\">\n  <li>Forces decisions to be defensible, not decorative</li>\n  <li>Anchors discussion on outcomes, not taste</li>\n  <li>Makes constraints and tradeoffs visible</li>\n</ul>\n\n<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 12px 0;\">\n  <h3 style=\"margin:0;font-size:18px;letter-spacing:-0.01em;\">Real-life Example</h3>\n  <button type=\"button\" class=\"drawer-example__refresh\" data-drawer-refresh>\n    <span aria-hidden=\"true\">↻</span> Refresh\n  </button>\n</div>\n\n<div style=\"border-radius:14px;border:1px solid var(--border);background:color-mix(in oklab, var(--brand) 8%, var(--surface));padding:10px;\">\n  <img src=\"./assets/accord-internal-external-identifiers.png\" alt=\"Accord UI showing a contact role menu with internal and external identifiers.\" style=\"width:100%;height:auto;display:block;border-radius:12px;\" loading=\"lazy\" decoding=\"async\" />\n</div>\n\n<div style=\"margin-top:10px;\">\n  <div style=\"font-size:13px;color:var(--muted);\">Accord: Figma for Sales</div>\n  <div style=\"font-size:14px;font-weight:600;letter-spacing:-0.01em;\">Internal / External Identifiers</div>\n</div>\n",
    "badge": "Design Tenet"
  },
  "dont-reinvent-the-wheel": {
    "title": "Reuse before reinvent",
    "subtitle": "Lean on existing design conventions wherever possible. Familiar patterns reduce cognitive load & build user trust & confidence. Focus creativity where it actually matters. Your differentiators.",
    "bodyHtml": "<div aria-hidden=\"true\" style=\"width:28px;height:28px;color:var(--brand);\">\n  <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n    <!-- simple \"roller\" icon -->\n    <path d=\"M11 5.5A2.5 2.5 0 0 1 13.5 3h6A1.5 1.5 0 0 1 21 4.5v3A1.5 1.5 0 0 1 19.5 9h-6A2.5 2.5 0 0 0 11 11.5v1.4l-2.1-2.1a1 1 0 1 0-1.4 1.4l4.6 4.6a1 1 0 0 0 1.4 0l4.6-4.6a1 1 0 0 0-1.4-1.4L14 12.9v-1.4A4.5 4.5 0 0 0 9.5 7H11Z\"\n      fill=\"currentColor\" opacity=\"0.0\"/>\n    <path d=\"M12 7.5A3.5 3.5 0 0 1 15.5 4h5A1 1 0 0 1 21.5 5v2.5A1 1 0 0 1 20.5 8h-5A3.5 3.5 0 0 0 12 11.5v2.0l2.2 2.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    <path d=\"M10.3 11.6 12 13.3 13.7 15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    <circle cx=\"7.1\" cy=\"14.9\" r=\"2.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n  </svg>\n</div>\n\n<div style=\"margin-top:10px;\">\n  <span class=\"chip\" style=\"cursor:default;\">Design Tenet</span>\n</div>\n\n<hr style=\"border:0;border-top:1px solid var(--border);margin:16px 0;\" />\n\n<h3 style=\"margin:0 0 10px 0;font-size:18px;letter-spacing:-0.01em;\">What this looks like</h3>\n<ul style=\"margin:0 0 18px 0;padding-left:18px;\">\n  <li>Lean on familiar UI patterns users already understand</li>\n  <li>Reduce cognitive load by aligning with mental models</li>\n  <li>Choose clarity over cleverness for core interactions</li>\n  <li>Focus creativity on true product differentiators</li>\n</ul>\n\n<h3 style=\"margin:0 0 10px 0;font-size:18px;letter-spacing:-0.01em;\">Why this matters</h3>\n<ul style=\"margin:0 0 22px 0;padding-left:18px;\">\n  <li>Preserves energy for truly novel problems</li>\n  <li>Aligns UI with existing mental models</li>\n  <li>Reduces risk through proven patterns</li>\n</ul>\n\n<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 12px 0;\">\n  <h3 style=\"margin:0;font-size:18px;letter-spacing:-0.01em;\">Real-life Example</h3>\n  <button type=\"button\" class=\"drawer-example__refresh\" data-drawer-refresh>\n    <span aria-hidden=\"true\">↻</span> Refresh\n  </button>\n</div>\n\n<div class=\"drawer-example\" style=\"padding:10px;\">\n  <div class=\"drawer-example__head\" style=\"margin-bottom:8px;\">\n    <div class=\"drawer-example__meta\">\n      <div class=\"drawer-example__label\">Library resources</div>\n      <div class=\"drawer-example__title\"><span data-drawer-updated>Last updated: December 28, 2025</span></div>\n    </div>\n  </div>\n\n  <div class=\"drawer-example__table\" role=\"table\" aria-label=\"Library resources\">\n    <div class=\"drawer-example__row\" role=\"row\" style=\"background:var(--surface);color:var(--muted);font-size:12px;\">\n      <div class=\"drawer-example__name\" role=\"cell\" style=\"font-size:12px;\">Name</div>\n      <div class=\"drawer-example__by\" role=\"cell\" style=\"font-size:12px;\">Added by</div>\n    </div>\n\n    <div class=\"drawer-example__row\" role=\"row\">\n      <div class=\"drawer-example__name\" role=\"cell\">\n        <span aria-hidden=\"true\" style=\"width:22px;height:22px;border-radius:7px;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;background:color-mix(in oklab, #f8d04a 35%, var(--surface));\">\n          <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\">\n            <path d=\"M7 4h7l3 3v13H7z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n            <path d=\"M14 4v4h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        <span>POC Results</span>\n      </div>\n      <div class=\"drawer-example__by\" role=\"cell\">\n        <span class=\"drawer-example__avatar\" aria-hidden=\"true\"></span>\n        <span>Rhond</span>\n      </div>\n    </div>\n\n    <div class=\"drawer-example__row\" role=\"row\">\n      <div class=\"drawer-example__name\" role=\"cell\">\n        <span aria-hidden=\"true\" style=\"width:22px;height:22px;border-radius:7px;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;background:color-mix(in oklab, #ff4d5a 26%, var(--surface));\">\n          <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\">\n            <path d=\"M7 4h7l3 3v13H7z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n            <path d=\"M14 4v4h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        <span>Figma Case Study</span>\n        <span aria-hidden=\"true\" style=\"display:inline-flex;gap:4px;margin-left:6px;opacity:.85;\">\n          <span style=\"width:5px;height:5px;border-radius:2px;background:var(--brand);display:inline-block;\"></span>\n          <span style=\"width:5px;height:5px;border-radius:2px;background:var(--brand);display:inline-block;\"></span>\n          <span style=\"width:5px;height:5px;border-radius:2px;background:var(--brand);display:inline-block;\"></span>\n        </span>\n      </div>\n      <div class=\"drawer-example__by\" role=\"cell\">\n        <span class=\"drawer-example__avatar\" aria-hidden=\"true\"></span>\n        <span>Rhond</span>\n      </div>\n    </div>\n\n    <div class=\"drawer-example__row\" role=\"row\">\n      <div class=\"drawer-example__name\" role=\"cell\">\n        <span aria-hidden=\"true\" style=\"width:22px;height:22px;border-radius:7px;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;background:color-mix(in oklab, #5aa7ff 22%, var(--surface));\">\n          <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\">\n            <path d=\"M7 4h7l3 3v13H7z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n            <path d=\"M14 4v4h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        <span>Help Documentation</span>\n        <span aria-hidden=\"true\" style=\"display:inline-flex;gap:4px;margin-left:6px;opacity:.85;\">\n          <span style=\"width:5px;height:5px;border-radius:2px;background:var(--brand);display:inline-block;\"></span>\n          <span style=\"width:5px;height:5px;border-radius:2px;background:var(--brand);display:inline-block;\"></span>\n          <span style=\"width:5px;height:5px;border-radius:2px;background:var(--brand);display:inline-block;\"></span>\n        </span>\n      </div>\n      <div class=\"drawer-example__by\" role=\"cell\">\n        <span class=\"drawer-example__avatar\" aria-hidden=\"true\"></span>\n        <span>Rhond</span>\n      </div>\n    </div>\n\n    <div class=\"drawer-example__row\" role=\"row\">\n      <div class=\"drawer-example__name\" role=\"cell\">\n        <span aria-hidden=\"true\" style=\"width:22px;height:22px;border-radius:7px;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;background:color-mix(in oklab, #26c281 22%, var(--surface));\">\n          <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\">\n            <path d=\"M7 4h7l3 3v13H7z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n            <path d=\"M14 4v4h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        <span>ROI Calculator</span>\n        <span aria-hidden=\"true\" style=\"display:inline-flex;gap:4px;margin-left:6px;opacity:.85;\">\n          <span style=\"width:5px;height:5px;border-radius:2px;background:var(--brand);display:inline-block;\"></span>\n          <span style=\"width:5px;height:5px;border-radius:2px;background:var(--brand);display:inline-block;\"></span>\n          <span style=\"width:5px;height:5px;border-radius:2px;background:var(--brand);display:inline-block;\"></span>\n        </span>\n        <span style=\"margin-left:8px;font-size:12px;border:1px solid var(--border);background:color-mix(in oklab, var(--brand) 8%, var(--surface));border-radius:999px;padding:4px 8px;display:inline-flex;align-items:center;gap:6px;\">\n          <span aria-hidden=\"true\">✎</span> Edit Library Resource\n        </span>\n      </div>\n      <div class=\"drawer-example__by\" role=\"cell\">\n        <span class=\"drawer-example__avatar\" aria-hidden=\"true\"></span>\n        <span>Rhond</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<p class=\"drawer-caption\">Accord: Figma for Sales</p>\n",
    "badge": ""
  },
  "start-with-a-sketch": {
    "title": "Sketch to learn",
    "subtitle": "Great solutions start high-level. Explore ideas at a whiteboard-level to keep them fast, flexible, & collaborative. Reveal assumptions early, & keep everyone aligned on the problem, not the pixels.",
    "bodyHtml": "<div aria-hidden=\"true\" style=\"width:28px;height:28px;color:var(--brand);\">\n  <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n    <path d=\"M20 4a3 3 0 0 0-4.2 0l-8.9 8.9c-.2.2-.4.5-.5.8l-1 3.6c-.2.7.4 1.3 1.1 1.1l3.6-1c.3-.1.6-.3.8-.5L20 8.2A3 3 0 0 0 20 4Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n    <path d=\"M13.2 6.8l4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n  </svg>\n</div>\n\n<div style=\"margin-top:10px;\">\n  <span class=\"chip\" style=\"cursor:default;\">Design Tenet</span>\n</div>\n\n<hr style=\"border:0;border-top:1px solid var(--border);margin:16px 0;\" />\n\n<h3 style=\"margin:0 0 10px 0;font-size:18px;letter-spacing:-0.01em;\">What this looks like</h3>\n<ul style=\"margin:0 0 18px 0;padding-left:18px;\">\n  <li>Explore ideas quickly before touching high fidelity</li>\n  <li>Keep concepts loose to invite collaboration</li>\n  <li>Surface assumptions early in the process</li>\n  <li>Align on the problem before aligning on the pixels</li>\n</ul>\n\n<h3 style=\"margin:0 0 10px 0;font-size:18px;letter-spacing:-0.01em;\">Why this matters</h3>\n<ul style=\"margin:0 0 22px 0;padding-left:18px;\">\n  <li>Prevents early commitment to one solution</li>\n  <li>Keeps focus on flow, not polish</li>\n  <li>Reduces changes further in the process</li>\n</ul>\n\n<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 12px 0;\">\n  <h3 style=\"margin:0;font-size:18px;letter-spacing:-0.01em;\">Real-life Example</h3>\n  <button type=\"button\" class=\"drawer-example__refresh\" data-drawer-refresh>\n    <span aria-hidden=\"true\">↻</span> Refresh\n  </button>\n</div>\n\n<div style=\"border-radius:14px;border:1px solid var(--border);background:color-mix(in oklab, var(--brand) 8%, var(--surface));padding:10px;\">\n  <img src=\"./assets/start-with-a-sketch-example.png\" alt=\"Early whiteboard sketch exploring a flow and layout before moving into high fidelity.\" style=\"width:100%;height:auto;display:block;border-radius:12px;\" loading=\"lazy\" decoding=\"async\" />\n</div>\n",
    "badge": ""
  },
  "fake-content-fake-designs": {
    "title": "Real content wins",
    "subtitle": "Ban Lorem Ipsum. \"Content precedes design\" is central to effective solutions. Design in the absence of content is not design... it's decoration.",
    "bodyHtml": "<h4>What this looks like</h4>\n<ul class=\"drawer-list\">\n  <li>Use real data, language, &amp; scenarios from the start</li>\n  <li>Test flows with actual edge cases, not placeholders</li>\n  <li>Shape UI around real content needs</li>\n  <li>Make copy part of the design, not an afterthought</li>\n</ul>\n\n<h4>Why this matters</h4>\n<ul class=\"drawer-list\">\n  <li>Reveals real constraints early</li>\n  <li>Surfaces edge cases while change is cheap</li>\n  <li>Holds up under real usage</li>\n</ul>\n\n<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:24px;\">\n  <h4 style=\"margin:0;\">Real-life Example</h4>\n  <button class=\"drawer-example__refresh\" type=\"button\">\n    <span aria-hidden=\"true\">⟳</span> Refresh\n  </button>\n</div>\n\n<div style=\"margin-top:12px;border:1px solid var(--border);border-radius:14px;overflow:hidden;\">\n  <img src=\"./assets/fake-content-example.png\" alt=\"Accord Modular Playbooks preview\" style=\"display:block;width:100%;height:auto;\" loading=\"lazy\">\n</div>\n\n<p class=\"drawer-caption\" style=\"margin-top:14px;\">\n  <span style=\"color:var(--muted);\">Accord: Figma for Sales</span><br>\n  <strong>Accord Modular Playbooks</strong>\n</p>",
    "badge": "Design Tenet"
  },
  "anticipate-extremes": {
    "title": "Anticipate extremes",
    "subtitle": "Anticipate boundary conditions & stress test scenarios so the system remains clear, resilient, & predictable.",
    "bodyHtml": "<h4>What this looks like</h4>\n<ul class=\"drawer-list\">\n  <li>Stress-test longest labels, biggest datasets, &amp; messy inputs</li>\n  <li>Ensure components hold up under worst-case scenarios</li>\n  <li>Design for scaling, accessibility, &amp; localization</li>\n  <li>Build interfaces that stay usable beyond the happy path</li>\n</ul>\n\n<h4>Why this matters</h4>\n<ul class=\"drawer-list\">\n  <li>Exposes failure modes early</li>\n  <li>Strengthens systems under stress</li>\n  <li>Improves resilience at scale</li>\n</ul>\n\n<div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:24px;\">\n  <h4 style=\"margin:0;\">Real-life Example</h4>\n  <button class=\"drawer-example__refresh\" type=\"button\">\n    <span aria-hidden=\"true\">⟳</span> Refresh\n  </button>\n</div>\n\n<div style=\"margin-top:12px;border:1px solid var(--border);border-radius:14px;overflow:hidden;\">\n  <img src=\"./assets/anticipate-extremes-modular-playbooks.png\" alt=\"Accord Modular Playbooks preview\" style=\"display:block;width:100%;height:auto;\" loading=\"lazy\">\n</div>\n\n<p class=\"drawer-caption\" style=\"margin-top:14px;\">\n  <span style=\"color:var(--muted);\">Accord: Figma for Sales</span><br>\n  <strong>Accord Modular Playbooks</strong>\n</p>",
    "badge": "Design Tenet"
  }
}
